# Campus Auction Frontend Environment Variables

# API Endpoint (Express Backend)
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Web Client SDK Configuration
# Note: When left empty or set to placeholders, CampusBid runs in Demo / Setup Mode
# allowing complete testing of the UI, bidding engine, anti-sniping, and seller actions.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-app-id:web:your-hash
