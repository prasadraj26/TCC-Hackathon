rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }
    
    // Auctions
    // Public read for exploration; sensitive updates (bids, status transitions) 
    // are strictly performed via the Express backend with Firebase Admin SDK 
    // to preserve atomic invariants and prevent bypassing validation.
    match /auctions/{auctionId} {
      allow read: if true;
      
      // Direct client creation: allowed if user is authenticated and sets themselves as seller
      allow create: if isAuthenticated() && request.resource.data.sellerUid == request.auth.uid
                    && request.resource.data.status == 'LIVE'
                    && request.resource.data.bidCount == 0;
                    
      // Direct client edits: seller can update description/images if no bids placed yet.
      // Crucial: clients CANNOT modify currentPrice, currentLeaderUid, bidCount, endsAt, or status directly!
      allow update: if isAuthenticated() && resource.data.sellerUid == request.auth.uid
                    && resource.data.bidCount == 0
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentPrice', 'currentLeaderUid', 'bidCount', 'status', 'endsAt']);
                    
      allow delete: if false; // cancellations are handled via status transition
      
      // Bid History Subcollection
      // Bids are strictly appended through backend transactions to ensure concurrency control,
      // server-side clock verification, and anti-sniping extension enforcement.
      match /bids/{bidId} {
        allow read: if true;
        allow write: if false; // Must be placed via Express REST backend
      }
    }
    
    // Auto Bids Collection
    // Students can manage their own auto-bid preferences.
    match /autoBids/{autoBidId} {
      allow read: if isAuthenticated() && resource.data.bidderUid == request.auth.uid;
      allow write: if false; // Registered through server to validate against current price
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false; // Generated by server
    }
    
    // Saved Searches Collection
    match /savedSearches/{searchId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
