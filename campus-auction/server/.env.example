# Campus Auction Backend Environment Variables

# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin SDK Configuration
# Note: If credentials are not provided or are placeholders, the server starts in
# Demo / Local Mode with simulated transactional state for hackathon evaluation.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account JSON key file (optional if using application default credentials)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Cloudinary Configuration (for listing image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
